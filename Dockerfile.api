# ============================================
# NYVORA API - NestJS Dockerfile (Single Stage)
# ============================================

FROM node:20-slim
RUN npm install -g pnpm@9.15.4
WORKDIR /app

ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PORT=3001

COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/types/package.json ./packages/types/
COPY packages/database/package.json ./packages/database/

RUN pnpm install --frozen-lockfile

RUN apt-get update -y && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

COPY apps/api ./apps/api
COPY packages ./packages

# Generated Prisma client is committed to the repo (with linux engine binary),
# so no prisma generate step is needed at build time.
RUN cd packages/database && npx tsc 2>&1
RUN cd apps/api && npx nest build 2>&1

ENV NODE_ENV=production
EXPOSE 3001
CMD ["node", "apps/api/dist/main.js"]

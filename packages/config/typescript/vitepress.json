{
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "paths": {
      "@/*": ["./*"],
      "@nyvora/shared/*": ["../packages/shared/src/*"],
      "@nyvora/types/*": ["../packages/types/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.vue", ".vitepress/**/*"],
  "exclude": ["node_modules", ".vitepress/dist"]
}
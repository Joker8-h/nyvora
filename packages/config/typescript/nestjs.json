{
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"],
      "@nyvora/shared/*": ["../../packages/shared/src/*"],
      "@nyvora/database/*": ["../../packages/database/src/*"],
      "@nyvora/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  seed          = "node ../prisma/seed.ts"
}

// ============================================
// CORE - Organization Centric
// ============================================

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  logo      String?
  plan      String    @default("free")
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches               Branch[]
  memberships            Membership[]
  invitations            Invitation[]
  crmContacts            CrmContact[]
  crmCompanies           CrmCompany[]
  crmLeads               CrmLead[]
  crmPipelines           CrmPipeline[]
  products               Product[]
  productCategories      ProductCategory[]
  warehouses             Warehouse[]
  stockLevels            StockLevel[]
  stockMovements         StockMovement[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  financeAccounts        FinanceAccount[]
  financeCategories      FinanceCategory[]
  financeTransactions    FinanceTransaction[]
  departments            Department[]
  positions              Position[]
  employees              Employee[]
  projects               Project[]
  salesQuotations        SalesQuotation[]
  salesOrders            SalesOrder[]
  salesInvoices          SalesInvoice[]
  salesPayments          SalesPayment[]
  notifications          Notification[]
  documents              Document[]
  templates              Template[]
  apiKeys                ApiKey[]
  meetings               Meeting[]
  webhooks               Webhook[]
  automations            Automation[]
  marketingCampaigns     MarketingCampaign[]
  emailTemplates         EmailTemplate[]
  marketingSegments      MarketingSegment[]
  novaOrgSkills          NovaOrgSkill[]
  appInstallations       AppInstallation[]
  integrationCredentials IntegrationCredential[]
  campaignMessages       CampaignMessage[]
  whatsappSession        WhatsappSession?
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        Json?
  phone          String?
  isHeadquarters Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  warehouses Warehouse[]
  employees  Employee[]

  @@index([organizationId])
}

// ============================================
// AUTH & IDENTITY
// ============================================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  avatar          String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships        Membership[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  sessions           Session[]
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  timeEntries        TimeEntry[]
  notifications      Notification[]
  documents          Document[]
  employees          Employee?
  organizedMeetings  Meeting[]           @relation("MeetingOrganizer")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([tokenHash])
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("employee")
  branchIds      String[]     @default([])
  invitedById    String?
  invitedAt      DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String
  token          String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([token])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model EmailVerification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model Session {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  ipAddress      String?
  userAgent      String?
  lastActiveAt   DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([lastActiveAt])
}

// ============================================
// CRM
// ============================================

model CrmContact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String?
  company        CrmCompany?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  position       String?
  type           String       @default("lead")
  tags           String[]     @default([])
  customFields   Json         @default("{}")
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  crmLeads        CrmLead[]
  salesQuotations SalesQuotation[]
  salesOrders     SalesOrder[]
  salesInvoices   SalesInvoice[]
  projects        Project[]

  @@index([organizationId])
  @@index([companyId])
  @@index([email])
}

model CrmCompany {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  industry       String?
  website        String?
  address        Json?
  taxId          String?
  notes          String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  contacts CrmContact[]

  @@index([organizationId])
  @@index([name])
}

model CrmLead {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           CrmContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipelineId        String
  pipeline          CrmPipeline  @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage             String
  status            String       @default("active")
  title             String?
  notes             String?
  source            String?
  score             Int          @default(0)
  assignedToId      String?
  estimatedValue    BigInt?
  expectedCloseDate DateTime?
  convertedAt       DateTime?
  lostReason        String?
  createdById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  activities CrmLeadActivity[]

  @@index([organizationId])
  @@index([pipelineId])
  @@index([stage])
  @@index([status])
  @@index([assignedToId])
}

model CrmLeadActivity {
  id          String   @id @default(uuid())
  leadId      String
  lead        CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String
  content     String
  occurredAt  DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())

  @@index([leadId])
}

model CrmPipeline {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  stages         Json         @default("[]")
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  leads CrmLead[]

  @@index([organizationId])
}

// ============================================
// INVENTORY
// ============================================

model ProductCategory {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  parentId       String?
  parent         ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       ProductCategory[] @relation("CategoryHierarchy")
  createdAt      DateTime          @default(now())

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([parentId])
}

model Product {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku                String
  name               String
  description        String?
  categoryId         String?
  category           ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitPrice          BigInt
  currency           String           @default("USD")
  hasBatches         Boolean          @default(false)
  allowNegativeStock Boolean          @default(false)
  isActive           Boolean          @default(true)
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  purchaseOrderLines  PurchaseOrderLine[]
  salesQuotationItems SalesQuotationItem[]
  salesOrderItems     SalesOrderItem[]
  salesInvoiceItems   SalesInvoiceItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
  @@index([sku])
}

model Warehouse {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name           String
  address        Json?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([branchId])
}

model StockLevel {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity        Int          @default(0)
  minimumQuantity Int          @default(0)
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

model StockMovement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  type           String
  quantity       Int
  unitCost       BigInt?
  transferId     String?
  referenceType  String?
  referenceId    String?
  reason         String?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@index([transferId])
  @@index([createdAt])
}

// ============================================
// PURCHASING
// ============================================

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  taxId          String?
  email          String?
  phone          String?
  address        Json?
  paymentTerms   Int          @default(30)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
  @@index([name])
}

model PurchaseOrder {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status         String       @default("draft")
  expectedDate   DateTime?
  notes          String?
  total          BigInt       @default(0)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  lines PurchaseOrderLine[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderLine {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Int
  receivedQuantity Int           @default(0)
  unitPrice        BigInt
  subtotal         BigInt
  createdAt        DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([productId])
}

// ============================================
// SALES
// ============================================

model SalesQuotation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  contactId      String?
  contact        CrmContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status         String       @default("draft")
  validUntil     DateTime?
  subtotal       BigInt       @default(0)
  taxRate        Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount      BigInt       @default(0)
  total          BigInt       @default(0)
  notes          String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  items SalesQuotationItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([contactId])
  @@index([status])
}

model SalesQuotationItem {
  id          String         @id @default(uuid())
  quotationId String
  quotation   SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Int
  unitPrice   BigInt
  subtotal    BigInt
  createdAt   DateTime       @default(now())

  @@index([quotationId])
  @@index([productId])
}

model SalesOrder {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  quotationId    String?
  contactId      String?
  contact        CrmContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status         String       @default("pending")
  subtotal       BigInt       @default(0)
  taxAmount      BigInt       @default(0)
  total          BigInt       @default(0)
  notes          String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  items SalesOrderItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([contactId])
  @@index([status])
}

model SalesOrderItem {
  id          String     @id @default(uuid())
  orderId     String
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Int
  unitPrice   BigInt
  subtotal    BigInt
  createdAt   DateTime   @default(now())

  @@index([orderId])
  @@index([productId])
}

model SalesInvoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  orderId        String?
  contactId      String
  contact        CrmContact   @relation(fields: [contactId], references: [id], onDelete: Restrict)
  status         String       @default("draft")
  dueDate        DateTime?
  subtotal       BigInt       @default(0)
  taxAmount      BigInt       @default(0)
  total          BigInt       @default(0)
  paidAmount     BigInt       @default(0)
  voidedAt       DateTime?
  sentAt         DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  items    SalesInvoiceItem[]
  payments SalesPayment[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([contactId])
  @@index([orderId])
  @@index([status])
}

model SalesInvoiceItem {
  id          String       @id @default(uuid())
  invoiceId   String
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Int
  unitPrice   BigInt
  subtotal    BigInt
  createdAt   DateTime     @default(now())

  @@index([invoiceId])
  @@index([productId])
}

model SalesPayment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount         BigInt
  method         String
  reference      String?
  notes          String?
  paidAt         DateTime     @default(now())
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([invoiceId])
  @@index([paidAt])
}

// ============================================
// FINANCE
// ============================================

model FinanceAccount {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  type              String
  currency          String       @default("USD")
  balance           BigInt       @default(0)
  reconciledBalance BigInt       @default(0)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())

  transactions FinanceTransaction[]

  @@index([organizationId])
  @@index([type])
}

model FinanceCategory {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  parentId       String?
  parent         FinanceCategory?  @relation("FinanceCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       FinanceCategory[] @relation("FinanceCategoryHierarchy")
  type           String
  createdAt      DateTime          @default(now())

  transactions FinanceTransaction[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([parentId])
  @@index([type])
}

model FinanceTransaction {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId       String
  account         FinanceAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  categoryId      String?
  category        FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type            String
  amount          BigInt
  description     String?
  referenceType   String?
  referenceId     String?
  transactionDate DateTime
  isReconciled    Boolean          @default(false)
  createdById     String?
  createdAt       DateTime         @default(now())

  @@index([organizationId])
  @@index([accountId])
  @@index([categoryId])
  @@index([transactionDate])
}

// ============================================
// HR
// ============================================

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  managerId      String?
  createdAt      DateTime     @default(now())

  employees Employee[]

  @@index([organizationId])
}

model Position {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  departmentId   String?
  createdAt      DateTime     @default(now())

  employees Employee[]

  @@index([organizationId])
  @@index([departmentId])
}

model Employee {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  firstName      String
  lastName       String
  email          String
  phone          String?
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId     String?
  position       Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  hireDate       DateTime
  salary         BigInt?
  contractType   String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  absences    Absence[]
  evaluations Evaluation[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([branchId])
}

model Absence {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String
  startDate    DateTime
  endDate      DateTime
  notes        String?
  status       String   @default("pending")
  approvedById String?
  createdAt    DateTime @default(now())

  @@index([employeeId])
  @@index([status])
}

model Evaluation {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period       String
  selfScore    Int?
  managerScore Int?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([employeeId])
  @@index([period])
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         CrmContact?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  status         String       @default("planning")
  startDate      DateTime?
  endDate        DateTime?
  budgetHours    Int?
  createdById    String?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  tasks Task[]

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

model Task {
  id             String    @id @default(uuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  assigneeId     String?
  assignee       User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority       String    @default("medium")
  status         String    @default("todo")
  estimatedHours Int?
  dueDate        DateTime?
  createdById    String?
  createdBy      User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  timeEntries TimeEntry[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
}

model TimeEntry {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hours       Decimal  @db.Decimal(5, 2)
  description String?
  entryDate   DateTime
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([userId])
  @@index([entryDate])
}

// ============================================
// MARKETING
// ============================================

model MarketingCampaign {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           String
  channel        String       @default("email")
  provider       String?
  subject        String?
  body           String?
  templateId     String?
  segmentId      String?
  audienceSize   Int          @default(0)
  delayMs        Int          @default(5000)
  status         String       @default("draft")
  totalCount     Int          @default(0)
  sentCount      Int          @default(0)
  failedCount    Int          @default(0)
  error          String?
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages CampaignMessage[]

  @@index([organizationId])
  @@index([status])
}

model CampaignMessage {
  id                String            @id @default(uuid())
  campaignId        String
  campaign          MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient         String
  name              String?
  status            String            @default("pending")
  error             String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime          @default(now())

  @@index([campaignId])
  @@index([organizationId])
  @@index([status])
}

model Meeting {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  date           DateTime
  endDate        DateTime?
  location       String?
  organizerId    String?
  organizer      User?        @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  attendees      String[]
  status         String       @default("scheduled")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([date])
}

model IntegrationCredential {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String
  data           String
  meta           Json         @default("{}")
  isActive       Boolean      @default(true)
  lastTestedAt   DateTime?
  lastTestOk     Boolean?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model WhatsappSession {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status          String       @default("disconnected")
  qr              String?
  phoneNumber     String?
  lastConnectedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model EmailTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  subject        String?
  content        String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model MarketingSegment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  rules          Json
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ============================================
// NOTIFICATIONS & AUDIT
// ============================================

model Notification {
  id             String       @id @default(uuid())
  recipientId    String
  recipient      User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  message        String
  icon           String?
  link           String?
  module         String
  eventType      String
  isRead         Boolean      @default(false)
  metadata       Json?
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([recipientId])
  @@index([organizationId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  entityType     String
  entityId       String
  action         String
  userId         String?
  changes        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// DOCUMENTS & TEMPLATES
// ============================================

model Document {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  fileName       String
  fileSize       Int
  mimeType       String
  storageKey     String
  url            String
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
}

model Template {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           String
  content        String
  variables      Json?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([type])
}

// ============================================
// API & WEBHOOKS
// ============================================

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyHash        String       @unique
  keyPrefix      String
  permissions    Json         @default("[\"read\"]")
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([keyHash])
}

model Webhook {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  secret         String
  events         String[]
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ============================================
// NOVA & AUTOMATIONS
// ============================================

model NovaSkill {
  id                  String   @id @default(uuid())
  name                String   @unique
  description         String
  requiredPermissions String[]
  promptTemplate      String
  tools               Json?
  isSystem            Boolean  @default(false)
  createdAt           DateTime @default(now())

  orgSkills NovaOrgSkill[]

  @@index([name])
}

model NovaMessage {
  id             String   @id @default(uuid())
  conversationId String
  organizationId String
  userId         String
  role           String
  content        String
  toolCalls      Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([organizationId])
  @@index([userId])
}

model NovaOrgSkill {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skillId        String
  skill          NovaSkill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  installedAt    DateTime     @default(now())

  @@unique([organizationId, skillId])
  @@index([organizationId])
  @@index([skillId])
}

model Automation {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  triggerType     String
  triggerConfig   Json
  conditions      Json?
  actions         Json
  status          String       @default("draft")
  createdBy       String       @default("user")
  createdByUserId String?
  lastExecutedAt  DateTime?
  executionCount  Int          @default(0)
  successCount    Int          @default(0)
  failureCount    Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  executions AutomationExecution[]

  @@index([organizationId])
  @@index([status])
  @@index([triggerType])
}

model AutomationExecution {
  id            String     @id @default(uuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  triggerData   Json?
  conditionsMet Boolean    @default(true)
  results       Json?
  status        String
  error         String?
  durationMs    Int?
  createdAt     DateTime   @default(now())

  @@index([automationId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// MARKETPLACE
// ============================================

model AppInstallation {
  id             String       @id @default(uuid())
  appId          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  config         Json         @default("{}")
  isActive       Boolean      @default(true)
  installedAt    DateTime     @default(now())

  @@unique([appId, organizationId])
  @@index([appId])
  @@index([organizationId])
}
